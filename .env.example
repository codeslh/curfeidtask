# Sunucu
PORT=3000
PUBLIC_URL=http://localhost:3000
# Veritabanı ve yedekler
DATA_DIR=data
SESSION_DAYS=7

# İlk admin hesabı (boş bırakırsanız ilk açılışta tarayıcıdan oluşturulur)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# E-posta gönderimi (SMTP): işletmelere / ilan sahiplerine yazmak ve size bildirim gelmesi için.
# Boşsa e-postalar bu pencereye yazılır, bildirimler panelde yine görünür.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PASS = Google "uygulama şifresi"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Adınız <sizin@gmail.com>

# Gelen e-postalar (IMAP): size gelen cevaplar Konuşmalar'a eklenir. Boşsa SMTP kullanıcı/şifresi denenir.
# Gmail: imap.gmail.com
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# İş ilanı taraması (Kaynaklar sayfasındaki siteler). 0 yaparsanız otomatik tarama kapalı başlar.
SCANNER_ENABLED=1
SCANNER_INTERVAL_MINUTES=30

# Bölge taraması: OpenStreetMap anahtarsız çalışır. Google Places isteğe bağlı (ücretli).
GOOGLE_PLACES_API_KEY=
# Kendi Overpass / Nominatim sunucunuz varsa (isteğe bağlı)
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# WhatsApp Business Cloud API (isteğe bağlı). Boşsa mesajlar wa.me ile kendi WhatsApp'ınızdan gönderilir.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=bir-gizli-kelime
WHATSAPP_APP_SECRET=
# İşletmelere WhatsApp'tan otomatik ilk mesaj için Meta'da onaylanmış şablon adı
WHATSAPP_OUTREACH_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=tr
