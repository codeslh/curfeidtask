# Sunucu
PORT=3000
# Demo ve ödeme linkleri bu adresle oluşturulur (canlıda https://alanadiniz.com)
PUBLIC_URL=http://localhost:3000
# Veritabanı, üretilen projeler ve demolar
DATA_DIR=data
SESSION_DAYS=7

# İlk admin hesabı (boş bırakırsanız ilk açılışta tarayıcıdan oluşturulur)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Yapay zeka (Claude). Anahtar yoksa sistem DEMO modunda çalışır.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Anahtar olsa bile demo modunu zorlamak için:
# AI_MOCK=1

# Admin bildirim e-postaları (SMTP). Boşsa e-postalar konsola yazılır, panelde yine görünür.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kalfa <no-reply@alanadiniz.com>

# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=bir-gizli-kelime
WHATSAPP_APP_SECRET=

# Kartla ödeme (isteğe bağlı, Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Freelancer platformlarını otomatik tarama
SCANNER_ENABLED=0
SCANNER_INTERVAL_MINUTES=30

# Bölge taraması: OpenStreetMap anahtarsız çalışır. Google Places isteğe bağlı (ücretli).
GOOGLE_PLACES_API_KEY=
# Kendi Overpass / Nominatim sunucunuz varsa (isteğe bağlı)
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# WhatsApp ile ilk mesaj için Meta'da onaylanmış şablon adı (yoksa panelden wa.me bağlantısıyla gönderilir)
WHATSAPP_OUTREACH_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=tr

# Gelen e-postalar (müşteri cevapları). Boşsa SMTP kullanıcı/şifresi denenir. Gmail: imap.gmail.com
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# Demoları internete yayınlamak için (localhost adresini müşteri açamaz). app.netlify.com → User settings → Applications
NETLIFY_TOKEN=
